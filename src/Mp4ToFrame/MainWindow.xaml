<Window x:Class="Mp4ToFrame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MP4 → 序列帧 / 抠图" Height="860" Width="560"
        MinHeight="680" MinWidth="480"
        Loaded="Window_Loaded"
        Activated="Window_Activated"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Visible" Padding="12">
            <StackPanel>
                <GroupBox Header="工作区" Margin="0,0,0,8">
                    <StackPanel Margin="8">
                        <DockPanel LastChildFill="True" Margin="0,0,0,4">
                            <Button x:Name="BtnBrowseWorkspace" Content="浏览…" Width="72" DockPanel.Dock="Right"
                                    Margin="8,0,0,0" Click="BtnBrowseWorkspace_Click"/>
                            <TextBox x:Name="TxtWorkspace" VerticalContentAlignment="Center"
                                     TextChanged="TxtWorkspace_TextChanged"/>
                        </DockPanel>
                        <TextBlock x:Name="TxtPathVideo" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="Gray"
                                   FontSize="11"/>
                        <TextBlock x:Name="TxtPathFrame" TextWrapping="Wrap" Margin="0,2,0,0" Foreground="Gray"
                                   FontSize="11"/>
                        <TextBlock x:Name="TxtPathMatted" TextWrapping="Wrap" Margin="0,2,0,0" Foreground="Gray"
                                   FontSize="11"/>
                        <TextBlock x:Name="TxtPathFinal" TextWrapping="Wrap" Margin="0,2,0,0" Foreground="Gray"
                                   FontSize="11"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11" Foreground="DarkSlateGray">
                            将 MP4 放入 Video；序列帧输出到 Frame；抠图输出到 Matted；可将 Matted 按目标尺寸导出到 Final（或自定义文件夹）。
                        </TextBlock>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="视频（可选）" Margin="0,0,0,8">
                    <StackPanel Margin="8">
                        <ComboBox x:Name="ComboVideo" DisplayMemberPath="Display" SelectedValuePath="Path"
                                  SelectionChanged="ComboVideo_SelectionChanged"/>
                        <TextBlock x:Name="TxtVideoHint" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11"
                                   Foreground="Gray"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="FFmpeg" Margin="0,0,0,8">
                    <StackPanel Margin="8">
                        <TextBox x:Name="TxtFfmpeg" ToolTip="留空则自动查找：程序目录或 PATH"
                                 TextChanged="TxtFfmpeg_TextChanged"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" FontSize="11" Foreground="Gray">
                            请将 ffmpeg.exe 放在本程序同目录，或安装后加入 PATH，或在此填写完整路径。
                        </TextBlock>
                        <StackPanel x:Name="PanelFfmpegMissing" Visibility="Collapsed" Margin="0,8,0,0">
                            <TextBlock TextWrapping="Wrap" Foreground="DarkOrange" FontSize="11"
                                       Text="未检测到可用的 ffmpeg.exe。可点击下方一键下载便携版到程序目录，或使用 winget 安装（安装后请重启本程序或清空上方路径以从 PATH 查找）。"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="BtnDownloadFfmpeg" Content="下载便携版到程序目录" Margin="0,0,8,0"
                                        Click="BtnDownloadFfmpeg_Click"/>
                                <Button x:Name="BtnWingetFfmpeg" Content="使用 winget 安装"
                                        ToolTip="打开终端安装 Gyan.FFmpeg，可能需要确认 UAC"
                                        Click="BtnWingetFfmpeg_Click"/>
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11" Foreground="Gray"
                                       Text="便携版来源：BtbN FFmpeg-Builds（GPL），体积约 100MB+，请保持网络畅通。"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="导出：分辨率与帧率" Margin="0,0,0,8">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,6">宽度</TextBlock>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtWidth" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,6">高度</TextBlock>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtHeight" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,6">帧率 FPS</TextBlock>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtFps" Margin="0,0,0,6"/>
                        <CheckBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" x:Name="ChkMirror"
                                  Content="导出序列帧时左右镜像"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Border（L / R / T / B）裁切与外扩" Margin="0,0,0,8">
                    <StackPanel Margin="8">
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="DarkSlateGray" Margin="0,0,0,8"
                                   Text="正数：从该边向内裁切（像素）。负数：向该边外扩 |值| 像素，扩展区用下方「外扩填充」着色（默认透明）。"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,6">L（左）</TextBlock>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtBorderL" Margin="0,0,12,6"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,6,6">R（右）</TextBlock>
                            <TextBox Grid.Row="0" Grid.Column="3" x:Name="TxtBorderR" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0">T（上）</TextBlock>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtBorderT" Margin="0,0,12,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,6,0">B（下）</TextBlock>
                            <TextBox Grid.Row="1" Grid.Column="3" x:Name="TxtBorderB" Margin="0,0,0,0"/>
                        </Grid>
                        <TextBlock Margin="0,0,0,4">外扩填充 ARGB</TextBlock>
                        <TextBox x:Name="TxtBorderFillArgb"
                                 ToolTip="8 位十六进制 AARRGGBB，默认 00000000=全透明；可带 #。6 位 RRGGBB 视为不透明。"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="抠图 (Frame → Matted)" Margin="0,0,0,8">
                    <StackPanel Margin="8">
                        <TextBlock Margin="0,0,0,4">抠图方式</TextBlock>
                        <ComboBox x:Name="ComboMatteMode" Margin="0,0,0,8" SelectionChanged="ComboMatteMode_SelectionChanged"/>
                        <StackPanel x:Name="PanelRembgDetails">
                            <TextBlock Margin="0,0,0,4">rembg / python 路径（可选）</TextBlock>
                            <TextBox x:Name="TxtRembg"/>
                            <TextBlock Margin="0,8,0,4">抠图模型</TextBlock>
                            <ComboBox x:Name="ComboModel" SelectionChanged="ComboModel_SelectionChanged"/>
                            <StackPanel x:Name="PanelCustomModel" Visibility="Collapsed" Margin="0,8,0,0">
                                <TextBlock>自定义模型 ID</TextBlock>
                                <TextBox x:Name="TxtCustomModel" Margin="0,4,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkAlphaMatting" Content="Alpha matting (-a)" Margin="0,12,0,0"/>
                            <StackPanel x:Name="PanelErode" Margin="16,4,0,0">
                                <TextBlock Text="腐蚀 -ae（越小越保细节）"/>
                                <Slider x:Name="SliderErode" Minimum="0" Maximum="15" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="4"/>
                                <TextBlock x:Name="TxtErodeValue" HorizontalAlignment="Right" FontSize="11"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock VerticalAlignment="Center" Text="前景 -af" Margin="0,0,6,0"/>
                                    <TextBox x:Name="TxtRembgAf" Width="48" VerticalAlignment="Center"
                                             ToolTip="trimap 前景阈值，默认 240（与 rembg 一致）。蒙版略软时过高会把身体判成“未知区”而被 matting 抠淡；可试 200–220。"/>
                                    <TextBlock VerticalAlignment="Center" Text="背景 -ab" Margin="16,0,6,0"/>
                                    <TextBox x:Name="TxtRembgAb" Width="48" VerticalAlignment="Center"
                                             ToolTip="trimap 背景阈值，默认 10（与 rembg 一致）。范围 0–255。"/>
                                </StackPanel>
                            </StackPanel>
                            <CheckBox x:Name="ChkPostProcess" Content="蒙版后处理 (-ppm)" Margin="0,8,0,0"/>
                            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="并行进程数"/>
                                <ComboBox x:Name="ComboRembgParallel" Width="72" VerticalAlignment="Center"
                                          ToolTip="1=与官方 rembg 相同（单进程顺序）。2–8=多进程分批并行，可缩短总耗时；每进程会加载一份模型，内存占用约按进程数倍增。多进程时会限制每进程 OMP 线程数以减少争抢。"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="PanelWhiteKeyParams" Margin="0,4,0,0" Visibility="Collapsed">
                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="DarkSlateGray" Margin="0,0,0,8"
                                       Text="适用于背景为单一纯色。键控颜色填与背景一致的 RRGGBB（白底 FFFFFF、绿幕常用 00FF00 或 00B140、蓝幕常用 0047BB）。需 ffmpeg.exe；主体上勿出现与背景同色块。"/>
                            <TextBlock Margin="0,0,0,4">键控颜色 RRGGBB</TextBlock>
                            <TextBox x:Name="TxtWhiteKeyRgb" ToolTip="6 位十六进制，与导出序列帧背景色一致；可带 #。绿底示例：00FF00 或 00B140；蓝底示例：0047BB。"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0" Text="similarity"/>
                                <TextBox Grid.Column="1" x:Name="TxtWhiteKeySimilarity" Margin="0,0,16,0"
                                         ToolTip="与 FFmpeg colorkey 的 similarity，(0,1]，越大越多吃近背景色；默认 0.08。"/>
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0" Text="blend"/>
                                <TextBox Grid.Column="3" x:Name="TxtWhiteKeyBlend"
                                         ToolTip="边缘混合，[0,1]；默认 0.04。过大会糊边。"/>
                            </Grid>
                            <TextBlock Margin="0,10,0,4" Text="去溢色（减轻绿边/蓝边）"/>
                            <ComboBox x:Name="ComboWhiteKeyDespill"
                                      ToolTip="绿幕常见边缘发绿：选「自动」或「绿幕去边」在 colorkey 后接 FFmpeg despill。白底一般选「关闭」。FFmpeg 需支持 despill（较新版本）。"/>
                        </StackPanel>
                        <TextBlock Margin="0,10,0,4" Text="Matted 输出文件名后缀（可选）"/>
                        <TextBox x:Name="TxtMattedStemSuffix"
                                 ToolTip="接在文件名 stem 末尾、扩展名 .png 之前，如 _matt → frame_0001_matt.png；留空则与 stem 同名。勿含路径非法字符。"/>
                        <Expander Header="说明" Margin="0,8,0,0">
                            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0">
                                rembg：pip install &quot;rembg[cli,cpu]&quot; 等；若输出张数少于输入会报错。纯色底色键：不依赖 rembg，按键控色与 similarity 去底（白/绿/蓝等均可）。两种方式均可设「Matted 文件名后缀」。
                            </TextBlock>
                        </Expander>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="最终导出（Matted → 目标分辨率）" Margin="0,0,0,8">
                    <StackPanel Margin="8">
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="DarkSlateGray" Margin="0,0,0,8"
                                   Text="在「全分辨率」下抠图后，将 Matted 内图片等比缩放到下方目标宽高（不足处透明边），再应用下方 Border（与「视频抽帧」处 Border 规则相同），写入输出文件夹。"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,6">目标宽度</TextBlock>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtFinalWidth" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">目标高度</TextBlock>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtFinalHeight" Margin="0,0,0,0"/>
                        </Grid>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="DarkSlateGray" Margin="0,0,0,6"
                                   Text="Border（最终导出）：正=内切，负=外扩；填充色仅作用于外扩区域。"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,6">L</TextBlock>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtFinalBorderL" Margin="0,0,12,6"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,6,6">R</TextBlock>
                            <TextBox Grid.Row="0" Grid.Column="3" x:Name="TxtFinalBorderR" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0">T</TextBlock>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtFinalBorderT" Margin="0,0,12,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,6,0">B</TextBlock>
                            <TextBox Grid.Row="1" Grid.Column="3" x:Name="TxtFinalBorderB" Margin="0,0,0,0"/>
                        </Grid>
                        <TextBlock Margin="0,0,0,4">外扩填充 ARGB（最终 Border）</TextBlock>
                        <TextBox x:Name="TxtFinalBorderFillArgb" Margin="0,0,0,8"
                                 ToolTip="与视频抽帧 Border 相同：8 位 AARRGGBB，默认 00000000=全透明。"/>
                        <TextBlock Margin="0,0,0,4" Text="最终导出文件名后缀（可选）"/>
                        <TextBox x:Name="TxtFinalStemSuffix" Margin="0,0,0,8"
                                 ToolTip="拼在输出 .png 之前（接在 Matted 源 stem 末尾），例如 _1080p；留空则输出 stem 与 Matted 源一致。"/>
                        <TextBlock Margin="0,0,0,4">输出文件夹（可选）</TextBlock>
                        <DockPanel LastChildFill="True">
                            <Button x:Name="BtnBrowseFinalOutput" Content="浏览…" Width="72" DockPanel.Dock="Right"
                                    Margin="8,0,0,0" Click="BtnBrowseFinalOutput_Click"/>
                            <TextBox x:Name="TxtFinalOutputFolder" VerticalContentAlignment="Center"
                                     ToolTip="留空则使用工作路径下的 Final 文件夹"/>
                        </DockPanel>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="12,0,12,8">
            <TextBlock x:Name="TxtStatus" TextWrapping="Wrap" Foreground="DarkBlue" MinHeight="20"/>
            <ProgressBar x:Name="ProgressIndeterminate" Height="4" IsIndeterminate="False" Visibility="Collapsed"
                         Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Vertical" Margin="12,0,12,12">
            <Button x:Name="BtnVideoToFrame" Content="Video → Frame（仅序列帧）" Height="32" Margin="0,0,0,6"
                    Click="BtnVideoToFrame_Click"/>
            <Button x:Name="BtnVideoToFrameMatted" Content="Video → Frame → Matted" Height="32" Margin="0,0,0,6"
                    Click="BtnVideoToFrameMatted_Click"/>
            <Button x:Name="BtnFrameToMatted" Content="Frame → Matted（仅抠图，无需视频）" Height="28"
                    Click="BtnFrameToMatted_Click"/>
            <Button x:Name="BtnMattedToFinal" Content="Matted → 最终导出（按目标分辨率）" Height="28" Margin="0,6,0,0"
                    Click="BtnMattedToFinal_Click"/>
        </StackPanel>
    </Grid>
</Window>
